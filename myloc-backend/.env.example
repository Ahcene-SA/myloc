# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Database configuration (MySQL/MariaDB via PDO)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=myloc_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# JWT configuration
# Use a strong random string of at least 32 characters in production.
JWT_SECRET=change_me_in_production_please_use_a_long_random_string
JWT_EXPIRY=86400

# CORS: comma-separated list of allowed frontend origins.
# No spaces around commas. Do not use * in production.
ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8080,http://127.0.0.1,http://127.0.0.1:3000,http://127.0.0.1:8080,https://ahcene-sa.github.io

# Login rate limiting
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=900

# Application environment: development | production
APP_ENV=development

# Admin account created by `php database/seed.php` (choose your own, never commit .env)
ADMIN_EMAIL=admin@myloc.dz
ADMIN_PASSWORD=change_me_please

# ── E-mails ──────────────────────────────────────────────────
# log  : (développement) les e-mails sont enregistrés dans logs/mails/*.html, rien n'est envoyé
# smtp : envoi réel. Exemple Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=tls,
#        SMTP_USER=ton.adresse@gmail.com, SMTP_PASS=<mot de passe d'application Google>
MAIL_DRIVER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
MAIL_FROM=myloc.dz@gmail.com
MAIL_FROM_NAME=MYLOC.DZ
# Qui reçoit les alertes « nouvelle réservation » (plusieurs adresses séparées par des virgules).
# Vide = tous les propriétaires actifs.
AGENCY_NOTIFY_EMAIL=myloc.dz@gmail.com
AGENCY_PHONE=+213 560 55 05 90
CURRENCY=DA

# ── WhatsApp (alerte « nouvelle réservation » à l'agence) ────
# log      : (développement) le message est écrit dans logs/whatsapp/*.txt, rien n'est envoyé
# meta     : API Cloud WhatsApp officielle (Meta) : WHATSAPP_TOKEN (jeton permanent) +
#            WHATSAPP_PHONE_ID (numéro expéditeur déclaré chez Meta). L'envoi passe par un
#            template « utility » avec une variable {{1}} (le texte complet de l'alerte) —
#            WHATSAPP_TEMPLATE = son nom, WHATSAPP_LANG = sa langue.
# callmebot: service non officiel de test : WHATSAPP_APIKEY obtenu sur api.callmebot.com.
WHATSAPP_DRIVER=log
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=reservation
WHATSAPP_LANG=fr
WHATSAPP_APIKEY=
# Numéro WhatsApp qui reçoit les alertes, format international sans « + » (ex. 213560550590).
# Vide = reprise de AGENCY_PHONE au-dessus. C'est le téléphone de l'agence ; le numéro
# expéditeur déclaré chez Meta doit être un autre numéro.
WHATSAPP_TO=

# Adresse du site (pour les liens dans les e-mails).
# Développement : http://localhost:3001 et PAGE_SUFFIX vide.
# Site exporté (production) : https://ton-domaine.dz et PAGE_SUFFIX=.html
FRONTEND_URL=http://localhost:3001
PAGE_SUFFIX=

# ── Serveur ──────────────────────────────────────────────────
# Fuseau horaire de l'agence : dates « aujourd'hui », heures des e-mails et de MySQL (NOW(), CURDATE()).
APP_TIMEZONE=Africa/Algiers
# 1 seulement si l'API est derrière un proxy de confiance : le Nginx frontal de la stack
# Docker (réseau privé, l'entrypoint l'active automatiquement) transmet l'IP réelle du
# visiteur via X-Forwarded-For. En développement direct (php -S, tunnel Cloudflare),
# laisser 0 : ces en-têtes seraient falsifiables et permettraient de contourner les
# limiteurs par IP.
TRUST_PROXY=0
