# Image frontend MYLOC.DZ : build Next.js (export statique) puis servi par Nginx.
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
# npm ci : le lockfile (régénéré sous Linux, optionnelles @emnapi/* comprises) fixe
# exactement les versions — aucune dérive de dépendance au re-déploiement.
RUN npm ci --no-audit --no-fund
# La valeur de l'API vient de .env.production (commit dans le dépôt) — lue
# automatiquement par `next build`, aucun build-arg requis. Pour la changer :
# modifier .env.production et re-déployer.
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx-frontend.conf /etc/nginx/conf.d/default.conf
COPY deploy/nginx-headers.conf /etc/nginx/includes/headers.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80