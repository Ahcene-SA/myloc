# Image frontend MYLOC.DZ : build Next.js (export statique) puis servi par Nginx.
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
# npm install (et non npm ci) : le lockfile Windows ne référence pas les
# dépendances optionnelles Linux (@emnapi/*) et npm ci le refuse.
RUN npm install --no-audit --no-fund
# La valeur de l'API vient de .env.production (commit dans le dépôt) — lue
# automatiquement par `next build`, aucun build-arg requis. Pour la changer :
# modifier .env.production et re-déployer.
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx-frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80