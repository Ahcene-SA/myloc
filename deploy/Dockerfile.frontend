# Image frontend MYLOC.DZ : build Next.js (export statique) puis servi par Nginx.
FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
# npm install (et non npm ci) : le lockfile Windows ne référence pas les
# dépendances optionnelles Linux (@emnapi/*) et npm ci le refuse.
RUN npm install --no-audit --no-fund
COPY . .
# NEXT_PUBLIC_* est inliné pendant ce build : le changer demande un rebuild.
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx-frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80